<?xml version="1.0" encoding="UTF-8"?>
<addons>
  <addon id="repository.sniper" name="Sniper Repo" version="1.0.1" provider-name="sniper">
    <requires>
      <import addon="xbmc.addon" version="12.0.0" />
    </requires>
    <extension point="xbmc.addon.repository" name="Sniper Repo">
      <dir>
        <info compressed="false">https://StrayanSniper.github.io/sniper-repo/addons.xml</info>
        <checksum>https://StrayanSniper.github.io/sniper-repo/addons.xml.md5</checksum>
        <datadir zip="true">https://StrayanSniper.github.io/sniper-repo/zips/</datadir>
        <hashes>false</hashes>
      </dir>
      <checkinterval>3600</checkinterval>
    </extension>
    <extension point="xbmc.addon.metadata">
      <summary lang="en_GB">Sniper Repo</summary>
      <description lang="en_GB">Sniper Repository — Rugby Streams and more.</description>
      <platform>all</platform>
      <assets>
        <icon>icon.png</icon>
        <fanart>fanart.jpg</fanart>
      </assets>
    </extension>
  </addon>
  <addon id="plugin.video.rugbystreams" name="Rugby Streams" version="1.0.16" provider-name="rugbystreams">
    <requires>
      <import addon="xbmc.python" version="3.0.0" />
    </requires>
    <extension point="xbmc.python.pluginsource" library="default.py">
      <provides>video</provides>
    </extension>
    <extension point="xbmc.addon.metadata">
      <summary lang="en_GB">Rugby Streams</summary>
      <description lang="en_GB">Watch live Rugby Union &amp; Rugby League Streams</description>
      <platform>all</platform>
      <assets>
        <icon>icon.png</icon>
        <fanart>fanart.jpg</fanart>
      </assets>
    </extension>
  </addon>
  <addon id="plugin.video.sportshq" name="Sports HQ" version="1.0.47" provider-name="StrayanSniper">
    <requires>
      <import addon="xbmc.python" version="3.0.0" />
      <import addon="script.module.jetextractors" version="3.3.8e" optional="true" />
    </requires>
    <extension point="xbmc.python.pluginsource" library="default.py">
      <provides>video</provides>
    </extension>
    <extension point="xbmc.addon.metadata">
      <summary lang="en_GB">Sports HQ</summary>
      <description lang="en_GB">Live streams for Rugby Union, Rugby League, UFC and Boxing.</description>
      <platform>all</platform>
      <assets>
        <icon>icon.png</icon>
        <fanart>fanart.jpg</fanart>
      </assets>
    </extension>
  </addon>
  <addon id="script.module.jetextractors" name="JetExtractors" version="3.3.8e" provider-name="THE TEAM">
    <requires>
      <import addon="script.module.requests" optional="true" />
      <import addon="script.module.beautifulsoup4" optional="true" />
      <import addon="script.module.dateutil" optional="true" />
      <import addon="script.module.soupsieve" optional="true" />
      <import addon="script.module.pyairtable" optional="true" />
      <import addon="script.module.pyamf" optional="true" />
      <import addon="script.module.pycryptodome" optional="true" />
      <import addon="script.module.pyjsparser" optional="true" />
    </requires>
    <extension point="xbmc.python.module" library="lib" />
    <extension point="xbmc.addon.metadata">
      <platform>all</platform>
      <summary lang="en">Jet Extractors</summary>
      <description lang="en">Jet Extractors</description>
      <disclaimer lang="en" />
      <license>MIT</license>
      <assets>
        <icon>icon.png</icon>
        <fanart>fanart.jpg</fanart>
      </assets>
    </extension>
  </addon>
  <addon id="script.module.pyjsparser" name="pyjsparser" version="3.0.0" provider-name="Addons4Kodi">
    <requires>
    
  </requires>
    <extension point="xbmc.python.module" library="lib" />
    <extension point="xbmc.addon.metadata">
      <summary>Pure Python JavaScript Translator/Interpreter</summary>
      <description>Packed for Kodi from https://github.com/PiotrDabkowski/pyjsparser</description>
      <platform>all</platform>
      <language />
      <license>MIT</license>
      <forum />
      <website>https://github.com/PiotrDabkowski/pyjsparser</website>
      <source>https://github.com/PiotrDabkowski/pyjsparser</source>
      <email />
    </extension>
  </addon>
</addons>