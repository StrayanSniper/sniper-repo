<?xml version="1.0" encoding="UTF-8"?>
<addon id="plugin.video.sportshq"
       name="Sports HQ"
       version="1.0.16"
       provider-name="StrayanSniper">
  <requires>
    <import addon="xbmc.python" version="3.0.0"/>
  </requires>
  <extension point="xbmc.python.pluginsource" library="default.py">
    <provides>video</provides>
  </extension>
  <extension point="xbmc.addon.metadata">
    <summary lang="en_GB">Sports HQ</summary>
    <description lang="en_GB">Live streams for Rugby Union, Rugby League, UFC and Boxing.</description>
    <platform>all</platform>
    <assets>
      <icon>icon.png</icon>
      <fanart>fanart.jpg</fanart>
    </assets>
  </extension>
</addon>
