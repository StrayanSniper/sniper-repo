<?xml version="1.0" encoding="utf-8"?>
<window>
  <defaultcontrol always="true">100</defaultcontrol>
  <zorder>1</zorder>
  <coordinates>
    <system>1</system>
    <posx>0</posx>
    <posy>0</posy>
  </coordinates>

  <controls>

    <!-- BACKGROUND -->
    <control type="image" id="1">
      <left>0</left><top>0</top><width>1280</width><height>720</height>
      <texture colordiffuse="FF0D0F1A">white.png</texture>
    </control>

    <!-- HEADER BAR -->
    <control type="image" id="10">
      <left>0</left><top>0</top><width>1280</width><height>72</height>
      <texture colordiffuse="FF141828">white.png</texture>
    </control>
    <control type="image" id="11">
      <left>0</left><top>71</top><width>1280</width><height>2</height>
      <texture colordiffuse="FF2979FF">white.png</texture>
    </control>
    <control type="label" id="12">
      <left>24</left><top>0</top><width>300</width><height>72</height>
      <label>SPORTS HQ</label>
      <font>font16</font>
      <textcolor>FF2979FF</textcolor>
      <aligny>center</aligny>
    </control>
    <control type="label" id="13">
      <left>160</left><top>0</top><width>400</width><height>72</height>
      <label>· LIVE TV &amp; STREAMS</label>
      <font>font16</font>
      <textcolor>FFCCCCCC</textcolor>
      <aligny>center</aligny>
    </control>
    <control type="label" id="14">
      <left>1080</left><top>6</top><width>180</width><height>32</height>
      <label>$INFO[System.Time]</label>
      <font>font16</font>
      <textcolor>FF888888</textcolor>
      <align>right</align>
    </control>
    <control type="label" id="15">
      <left>1080</left><top>40</top><width>180</width><height>26</height>
      <label>$VAR[addon_version]</label>
      <font>font12</font>
      <textcolor>FF333355</textcolor>
      <align>right</align>
    </control>

    <!-- CHANNEL LIST — 160px rows, 150x150 logos, 4 channels visible -->
    <control type="list" id="100">
      <left>0</left><top>73</top><width>1280</width><height>647</height>
      <itemheight>160</itemheight>
      <scrolltime>200</scrolltime>
      <autoscroll time="3000" delay="10000" repeat="20000">false</autoscroll>
      <onleft>100</onleft>
      <onright>100</onright>

      <!-- ─── Normal (unfocused) row ─── -->
      <itemlayout height="160">
        <!-- Row separator -->
        <control type="image">
          <left>0</left><top>159</top><width>1280</width><height>1</height>
          <texture colordiffuse="18FFFFFF">white.png</texture>
        </control>
        <!-- Channel number -->
        <control type="label">
          <left>20</left><top>0</top><width>72</width><height>160</height>
          <label>$INFO[ListItem.Label2]</label>
          <font>font13</font>
          <textcolor>FF555577</textcolor>
          <align>center</align>
          <aligny>center</aligny>
        </control>
        <!-- 150x150 square logo -->
        <control type="image">
          <left>110</left><top>5</top><width>150</width><height>150</height>
          <texture>$INFO[ListItem.Icon]</texture>
          <aspectratio>keep</aspectratio>
        </control>
        <!-- Channel name (sport type e.g. NRL) -->
        <control type="label">
          <left>278</left><top>42</top><width>280</width><height>36</height>
          <label>$INFO[ListItem.Label]</label>
          <font>font13</font>
          <textcolor>FFDDDDDD</textcolor>
        </control>
        <!-- Sub-label -->
        <control type="label">
          <left>278</left><top>84</top><width>280</width><height>30</height>
          <label>$INFO[ListItem.Plot]</label>
          <font>font12</font>
          <textcolor>FF666688</textcolor>
        </control>
        <!-- Vertical divider -->
        <control type="image">
          <left>574</left><top>20</top><width>1</width><height>120</height>
          <texture colordiffuse="22FFFFFF">white.png</texture>
        </control>
        <!-- Programme / status (wraps to 2 lines) -->
        <control type="label">
          <left>590</left><top>28</top><width>666</width><height>104</height>
          <label>$INFO[ListItem.Genre]</label>
          <font>font13</font>
          <textcolor>FF888888</textcolor>
        </control>
      </itemlayout>

      <!-- ─── Focused (selected) row ─── -->
      <focusedlayout height="160">
        <!-- Selection background -->
        <control type="image">
          <left>0</left><top>0</top><width>1280</width><height>160</height>
          <texture colordiffuse="22FFFFFF">white.png</texture>
        </control>
        <!-- Left accent bar -->
        <control type="image">
          <left>0</left><top>0</top><width>4</width><height>160</height>
          <texture colordiffuse="FF2979FF">white.png</texture>
        </control>
        <!-- Row separator -->
        <control type="image">
          <left>0</left><top>159</top><width>1280</width><height>1</height>
          <texture colordiffuse="33FFFFFF">white.png</texture>
        </control>
        <!-- Channel number -->
        <control type="label">
          <left>20</left><top>0</top><width>72</width><height>160</height>
          <label>$INFO[ListItem.Label2]</label>
          <font>font13</font>
          <textcolor>FF2979FF</textcolor>
          <align>center</align>
          <aligny>center</aligny>
        </control>
        <!-- 150x150 square logo -->
        <control type="image">
          <left>110</left><top>5</top><width>150</width><height>150</height>
          <texture>$INFO[ListItem.Icon]</texture>
          <aspectratio>keep</aspectratio>
        </control>
        <!-- Channel name -->
        <control type="label">
          <left>278</left><top>42</top><width>280</width><height>36</height>
          <label>$INFO[ListItem.Label]</label>
          <font>font13</font>
          <textcolor>FFFFFFFF</textcolor>
        </control>
        <!-- Sub-label -->
        <control type="label">
          <left>278</left><top>84</top><width>280</width><height>30</height>
          <label>$INFO[ListItem.Plot]</label>
          <font>font12</font>
          <textcolor>FF8888AA</textcolor>
        </control>
        <!-- Vertical divider -->
        <control type="image">
          <left>574</left><top>20</top><width>1</width><height>120</height>
          <texture colordiffuse="44FFFFFF">white.png</texture>
        </control>
        <!-- Programme / status (wraps to 2 lines) -->
        <control type="label">
          <left>590</left><top>28</top><width>666</width><height>104</height>
          <label>$INFO[ListItem.Genre]</label>
          <font>font13</font>
          <textcolor>FFEEEEEE</textcolor>
        </control>
      </focusedlayout>

    </control>

  </controls>
</window>
