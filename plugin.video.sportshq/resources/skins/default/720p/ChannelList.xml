<?xml version="1.0" encoding="utf-8"?>
<window>
  <defaultcontrol always="true">100</defaultcontrol>
  <zorder>1</zorder>
  <coordinates>
    <system>1</system>
    <posx>0</posx>
    <posy>0</posy>
  </coordinates>

  <controls>

    <!-- ═══════════════════════════════════════════════════════ -->
    <!-- BACKGROUND                                              -->
    <!-- ═══════════════════════════════════════════════════════ -->
    <control type="image" id="1">
      <left>0</left><top>0</top><width>1280</width><height>720</height>
      <texture colordiffuse="FF0D0F1A">white.png</texture>
    </control>

    <!-- ═══════════════════════════════════════════════════════ -->
    <!-- HEADER BAR                                              -->
    <!-- ═══════════════════════════════════════════════════════ -->
    <control type="image" id="10">
      <left>0</left><top>0</top><width>1280</width><height>72</height>
      <texture colordiffuse="FF141828">white.png</texture>
    </control>
    <!-- Blue accent line under header -->
    <control type="image" id="11">
      <left>0</left><top>71</top><width>1280</width><height>2</height>
      <texture colordiffuse="FF2979FF">white.png</texture>
    </control>
    <!-- Sports HQ wordmark -->
    <control type="label" id="12">
      <left>24</left><top>0</top><width>300</width><height>72</height>
      <label>SPORTS HQ</label>
      <font>font16</font>
      <textcolor>FF2979FF</textcolor>
      <aligny>center</aligny>
    </control>
    <!-- Section title -->
    <control type="label" id="13">
      <left>160</left><top>0</top><width>400</width><height>72</height>
      <label>· LIVE TV &amp; STREAMS</label>
      <font>font16</font>
      <textcolor>FFCCCCCC</textcolor>
      <aligny>center</aligny>
    </control>
    <!-- Live clock -->
    <control type="label" id="14">
      <left>1080</left><top>0</top><width>180</width><height>72</height>
      <label>$INFO[System.Time]</label>
      <font>font16</font>
      <textcolor>FF888888</textcolor>
      <align>right</align>
      <aligny>center</aligny>
    </control>

    <!-- ═══════════════════════════════════════════════════════ -->
    <!-- CHANNEL LIST                                            -->
    <!-- ═══════════════════════════════════════════════════════ -->
    <control type="list" id="100">
      <left>0</left><top>73</top><width>1280</width><height>647</height>
      <itemheight>80</itemheight>
      <scrolltime>200</scrolltime>
      <autoscroll time="3000" delay="10000" repeat="20000">false</autoscroll>
      <onleft>100</onleft>
      <onright>100</onright>

      <!-- ─── Normal (unfocused) row ─── -->
      <itemlayout height="80">
        <!-- Row separator -->
        <control type="image">
          <left>0</left><top>79</top><width>1280</width><height>1</height>
          <texture colordiffuse="18FFFFFF">white.png</texture>
        </control>
        <!-- Channel number -->
        <control type="label">
          <left>0</left><top>0</top><width>72</width><height>80</height>
          <label>$INFO[ListItem.Label2]</label>
          <font>font13</font>
          <textcolor>FF555577</textcolor>
          <align>center</align>
          <aligny>center</aligny>
        </control>
        <!-- Channel logo -->
        <control type="image">
          <left>80</left><top>10</top><width>96</width><height>60</height>
          <texture>$INFO[ListItem.Icon]</texture>
          <aspectratio>keep</aspectratio>
        </control>
        <!-- Channel name -->
        <control type="label">
          <left>196</left><top>10</top><width>300</width><height>32</height>
          <label>$INFO[ListItem.Label]</label>
          <font>font13</font>
          <textcolor>FFDDDDDD</textcolor>
        </control>
        <!-- Sub-label (sport type / source) -->
        <control type="label">
          <left>196</left><top>44</top><width>300</width><height>26</height>
          <label>$INFO[ListItem.Plot]</label>
          <font>font12</font>
          <textcolor>FF666688</textcolor>
        </control>
        <!-- Programme / status (genre field carries live badge + title) -->
        <control type="label">
          <left>516</left><top>0</top><width>740</width><height>80</height>
          <label>$INFO[ListItem.Genre]</label>
          <font>font13</font>
          <textcolor>FF888888</textcolor>
          <aligny>center</aligny>
        </control>
        <!-- Divider -->
        <control type="image">
          <left>508</left><top>16</top><width>1</width><height>48</height>
          <texture colordiffuse="22FFFFFF">white.png</texture>
        </control>
      </itemlayout>

      <!-- ─── Focused (selected) row ─── -->
      <focusedlayout height="80">
        <!-- Selection background -->
        <control type="image">
          <left>0</left><top>0</top><width>1280</width><height>80</height>
          <texture colordiffuse="22FFFFFF">white.png</texture>
        </control>
        <!-- Left accent bar (blue) -->
        <control type="image">
          <left>0</left><top>0</top><width>4</width><height>80</height>
          <texture colordiffuse="FF2979FF">white.png</texture>
        </control>
        <!-- Row separator -->
        <control type="image">
          <left>0</left><top>79</top><width>1280</width><height>1</height>
          <texture colordiffuse="33FFFFFF">white.png</texture>
        </control>
        <!-- Channel number (brighter when focused) -->
        <control type="label">
          <left>0</left><top>0</top><width>72</width><height>80</height>
          <label>$INFO[ListItem.Label2]</label>
          <font>font13</font>
          <textcolor>FF2979FF</textcolor>
          <align>center</align>
          <aligny>center</aligny>
        </control>
        <!-- Channel logo -->
        <control type="image">
          <left>80</left><top>10</top><width>96</width><height>60</height>
          <texture>$INFO[ListItem.Icon]</texture>
          <aspectratio>keep</aspectratio>
        </control>
        <!-- Channel name (white when focused) -->
        <control type="label">
          <left>196</left><top>10</top><width>300</width><height>32</height>
          <label>$INFO[ListItem.Label]</label>
          <font>font13</font>
          <textcolor>FFFFFFFF</textcolor>
        </control>
        <!-- Sub-label -->
        <control type="label">
          <left>196</left><top>44</top><width>300</width><height>26</height>
          <label>$INFO[ListItem.Plot]</label>
          <font>font12</font>
          <textcolor>FF8888AA</textcolor>
        </control>
        <!-- Programme / status -->
        <control type="label">
          <left>516</left><top>0</top><width>740</width><height>80</height>
          <label>$INFO[ListItem.Genre]</label>
          <font>font13</font>
          <textcolor>FFEEEEEE</textcolor>
          <aligny>center</aligny>
        </control>
        <!-- Divider -->
        <control type="image">
          <left>508</left><top>16</top><width>1</width><height>48</height>
          <texture colordiffuse="44FFFFFF">white.png</texture>
        </control>
      </focusedlayout>

    </control>

  </controls>
</window>
