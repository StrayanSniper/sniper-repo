<?xml version="1.0" encoding="UTF-8"?>
<addon id="plugin.video.rugbystreams"
       name="Rugby Streams"
       version="1.0.17"
       provider-name="rugbystreams">
  <requires>
    <import addon="xbmc.python" version="3.0.0"/>
  </requires>
  <extension point="xbmc.python.pluginsource" library="default.py">
    <provides>video</provides>
  </extension>
  <extension point="xbmc.addon.metadata">
    <summary lang="en_GB">Rugby Streams</summary>
    <description lang="en_GB">Watch live Rugby Union &amp; Rugby League Streams</description>
    <platform>all</platform>
    <assets>
      <icon>icon.png</icon>
      <fanart>fanart.jpg</fanart>
    </assets>
  </extension>
</addon>
