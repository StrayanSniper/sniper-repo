<?xml version="1.0" encoding="UTF-8"?>
<addon id="repository.sniper"
       name="Sniper Repo"
       version="1.0.1"
       provider-name="sniper">
  <requires>
    <import addon="xbmc.addon" version="12.0.0"/>
  </requires>
  <extension point="xbmc.addon.repository" name="Sniper Repo">
    <dir>
      <info compressed="false">https://StrayanSniper.github.io/sniper-repo/addons.xml</info>
      <checksum>https://StrayanSniper.github.io/sniper-repo/addons.xml.md5</checksum>
      <datadir zip="true">https://StrayanSniper.github.io/sniper-repo/zips/</datadir>
      <hashes>false</hashes>
    </dir>
    <checkinterval>3600</checkinterval>
  </extension>
  <extension point="xbmc.addon.metadata">
    <summary lang="en_GB">Sniper Repo</summary>
    <description lang="en_GB">Sniper Repository — Rugby Streams and more.</description>
    <platform>all</platform>
    <assets>
      <icon>icon.png</icon>
      <fanart>fanart.jpg</fanart>
    </assets>
  </extension>
</addon>
